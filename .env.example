PORT=3000
API_PREFIX=/api/v1/pdf
# Directory of templates: <name>/index.html (+ *.css, *.partial.html, layout.html)
TEMPLATES_DIR=./templates
# Bearer token for every non-health route; empty = no auth (keep the service on an internal network)
PDF_SERVICE_TOKEN=
# Origins the page may load besides data: URLs, comma-separated (e.g. https://fonts.googleapis.com,https://fonts.gstatic.com)
PDF_ALLOWED_ORIGINS=
# Run scripts in request-supplied HTML (and allow waitForFunction)
PDF_ALLOW_SCRIPTS=false
PDF_CONCURRENCY=4
PDF_MAX_BODY_MB=10
PDF_TIMEOUT_MS=30000
# Chrome binary; auto-discovered when empty. CHROME_NO_SANDBOX=1 inside containers.
CHROME_PATH=
CHROME_NO_SANDBOX=
