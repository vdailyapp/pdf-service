{
  "name": "pdf-service",
  "version": "0.1.0",
  "description": "Bun-native PDF service and library: render complex HTML/CSS to PDF and fill templates over HTTP — zero runtime dependencies, driven by real Chrome via CDP.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts",
    "./server": "./src/server.ts"
  },
  "bin": {
    "pdf-service": "./src/cli.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "cli": "bun run src/cli.ts",
    "demo": "bun run examples/render.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit"
  },
  "keywords": [
    "pdf",
    "bun",
    "html-to-pdf",
    "template",
    "invoice",
    "chrome",
    "cdp",
    "puppeteer-alternative",
    "pdf-service",
    "microservice"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vdailyapp/pdf-service.git"
  },
  "homepage": "https://github.com/vdailyapp/pdf-service#readme",
  "bugs": {
    "url": "https://github.com/vdailyapp/pdf-service/issues"
  },
  "author": "Phạm Văn Nguyên <npv2k1@gmail.com>",
  "packageManager": "bun@1.4.3"
}
